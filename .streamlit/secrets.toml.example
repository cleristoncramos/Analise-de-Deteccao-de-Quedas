# Copie para .streamlit/secrets.toml (execução local) ou cole em
# Streamlit Cloud > Manage app > Settings > Secrets. Preencha UMA das opções.

[turn]
# Opção 1 - Metered (recomendado; plano gratuito): nome do app e API key do TURN Server
metered_app = ""
metered_api_key = ""

# Opção 2 - Twilio Network Traversal
# twilio_account_sid = ""
# twilio_auth_token = ""

# Opção 3 - lista fixa de servidores
# ice_servers = [
#   { urls = ["turn:turn.exemplo.org:3478"], username = "", credential = "" },
# ]
